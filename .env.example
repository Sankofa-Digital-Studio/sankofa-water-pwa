# ============================================================
# Sankofa Water PWA — Environment Variables
# ============================================================
# Copy this file to `.env.local` and fill in your values.
# NEVER commit `.env.local` to version control.
#
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# All others are server-only (API routes, Server Actions, middleware).
# ============================================================

# ── App ─────────────────────────────────────────────────────
# Full public URL of your deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — SERVER-SIDE ONLY, never expose to browser
# Used for admin operations (edge functions, server actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── ChirpStack IoT Gateway ───────────────────────────────────
# Secret used to verify HMAC signatures on incoming ChirpStack webhooks
CHIRPSTACK_WEBHOOK_SECRET=your-chirpstack-webhook-secret

# ── Meta / WhatsApp Business API ─────────────────────────────
# From: Meta for Developers → Your App → WhatsApp → API Setup
META_WHATSAPP_TOKEN=your-whatsapp-permanent-or-system-user-token
META_WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# ── Optional: Upstash Redis (rate-limiting / caching) ────────
# Uncomment if you add rate limiting via @upstash/ratelimit
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Optional: Resend (transactional email) ───────────────────
# RESEND_API_KEY=re_your-resend-api-key

# ── Optional: Sentry (error tracking) ───────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=sankofa-water-pwa
